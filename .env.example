# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase Postgres — use the pooler URLs from Project → Connect
# DATABASE_URL = transaction pooler (port 6543, ?pgbouncer=true) for the app
# DIRECT_URL   = session pooler (port 5432) for Prisma migrations
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign auth + invitation JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Separate secret for platform staff JWTs (admin.mydomain.com). Required in production.
PLATFORM_JWT_SECRET=change-me-platform-secret-different-from-jwt

# First platform OWNER seed (used by: npm run seed:platform-owner)
# PLATFORM_OWNER_EMAIL=ops@example.com
# PLATFORM_OWNER_PASSWORD=use-a-long-random-password
# PLATFORM_OWNER_NAME=Platform Owner

# Port Express listens on. Railway/Render inject this automatically; defaults to 3001.
PORT=3001

# Public base URL used to build invitation links (fallback when Origin is missing).
# Local Vite often runs on :3000 or :5173 — match the URL in your browser.
# Production: your deployed app URL (no trailing slash), e.g. https://app.mydomain.com
FRONTEND_URL=http://127.0.0.1:3000

# Platform admin origin (CORS). Local: http://127.0.0.1:3010
# Production: https://admin.mydomain.com
PLATFORM_ADMIN_URL=http://127.0.0.1:3010

# Marketing site origin (CORS for newsletter from apex domain)
# Production: https://teamflow.cyou
MARKETING_URL=http://127.0.0.1:3020

# Optional extra CORS origins (comma-separated), e.g. temporary Render URLs
# CORS_ORIGINS=https://teamflow-xxx.onrender.com

# Platform admin Static Site build-time env (Render):
# VITE_PLATFORM_API_BASE=https://app.mydomain.com
# (leave unset locally — Vite proxies /platform to :3001)

# Set to "production" on the host; leave unset locally.
NODE_ENV=development

# --- Email delivery (Resend recommended) ---
# After verifying your domain in Resend (e.g. teamflow.cyou), set:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM must use an address on that verified domain.
# Optional: EMAIL_ALLOWED_FROM_DOMAINS=teamflow.cyou (Compose From picker)
# The app uses Resend's HTTPS API (fast). Do not set SMTP_* when using Resend.
RESEND_API_KEY=
EMAIL_FROM="TeamFlow <noreply@teamflow.cyou>"

# Classic SMTP only (if not using Resend). Local fallback without either = Ethereal.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Multi-tenant SaaS is the default (anyone can create a company workspace).
# Set to "true" only for single-company demo deploys (invite-only after first admin).
SINGLE_TENANT_LOCK=false

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Application type: Web application
# Authorized JavaScript origins: http://127.0.0.1:3000 (and your production app URL)
# Authorized redirect URIs: not required for GIS ID-token button flow
GOOGLE_CLIENT_ID=
